<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================================
     ModernUI style_demo — .ui 布局文件

     标签 = C++ 控件类型；属性负责布局与行为：
       direction / gap / padding / width / height / flex-grow / align …
       text / items / checked / value / selected-index …
       onClick / onToggled / onValueChanged … = C++ handler 名称
     ===================================================================== -->
<ScrollViewer width="100%" height="100%">
<Card class="root" direction="column" gap="16" padding="26" width="100%">

    <!-- 标题行 -->
    <StackPanel direction="row" align="center" justify="space-between" width="100%">
        <StackPanel direction="column" gap="4">
            <TextBlock class="title" text="ModernUI · CSS + UI"/>
            <TextBlock class="hint"
                       text="C++ 定义控件 · .css 修改样式 · .ui 管理布局并回调 C++"/>
        </StackPanel>
        <Button id="applyBtn" class="primary" text="Apply theme" onClick="applyTheme"/>
    </StackPanel>

    <!-- 按钮 -->
    <Card class="section" direction="column" gap="12" padding="18" width="100%">
        <TextBlock class="label" text="BUTTONS"/>
        <StackPanel direction="row" gap="10" align="center">
            <Button class="primary" text="Primary" onClick="primaryAction"/>
            <Button text="Standard" onClick="standardAction"/>
            <Button variant="subtle" text="Subtle" onClick="subtleAction"/>
            <Button text="Disabled" enabled="false"/>
        </StackPanel>
    </Card>

    <!-- 选择 / 输入 -->
    <Card class="section" direction="column" gap="12" padding="18" width="100%">
        <TextBlock class="label" text="SELECTION &amp; INPUT"/>
        <StackPanel direction="row" gap="20" align="center">
            <CheckBox text="Enable glow" checked="true" onCheckedChanged="toggleAction"/>
            <ToggleSwitch text="Live preview" checked="true" onToggled="toggleAction"/>
            <Slider width="220" value="0.65" max="1" onValueChanged="sliderAction"/>
            <TextBox width="240" placeholder="Type here" onTextChanged="textAction"/>
        </StackPanel>
    </Card>

    <!-- 进度 / 状态 -->
    <Card class="section" direction="column" gap="12" padding="18" width="100%">
        <TextBlock class="label" text="PROGRESS &amp; STATUS"/>
        <StackPanel direction="row" gap="20" align="center">
            <ProgressBar width="260" progress="0.62"/>
            <ProgressRing width="44" height="44" progress="0.7"/>
            <ComboBox width="190" items="Dark|Light|High contrast"
                      selected-index="0" onSelectionChanged="comboAction"/>
            <InfoBadge value="3"/>
            <PipsPager pages="5" selected-page="2"
                       onSelectedPageChanged="pagerAction"/>
        </StackPanel>
    </Card>

    <!-- 集合 -->
    <Card class="section" direction="column" gap="12" padding="18" width="100%">
        <TextBlock class="label" text="COLLECTIONS"/>
        <StackPanel direction="row" gap="20" width="100%" align="start">
            <ListView width="280" height="150" items="Alpha|Beta|Gamma|Delta"
                      selected-index="1" onSelectionChanged="listAction"/>
            <TabView width="330" tabs="Overview|Styling|Data"
                     selected-index="1" onTabChanged="tabAction"/>
            <StackPanel direction="column" gap="8" flex-grow="1" justify="center">
                <TextBlock id="statusText" text="Ready — 点击任意控件触发 C++ handler。"/>
                <TextBlock class="hint"
                           text="hover / pressed / disabled 由 .css 状态伪类接管。"/>
            </StackPanel>
        </StackPanel>
    </Card>

    <!-- 组合式复杂控件：内部全部由基础控件 + Flexbox 排版 -->
    <Card class="section" direction="column" gap="12" padding="18" width="100%">
        <TextBlock class="label" text="COMPOSED CONTROLS"/>
        <StackPanel direction="row" gap="20" width="100%" align="start">
            <CalendarView id="demoCalendar" width="262" height="292"
                          year="2026" month="10" day="26"
                          onDateChanged="calendarAction"/>
            <TreeView id="demoTree" width="260" height="262"
                      onSelectionChanged="treeAction"/>
            <StackPanel direction="column" gap="8" flex-grow="1" justify="center">
                <TextBlock id="composedStatus"
                           text="CalendarView = Button + ToggleButton + TextBlock + StackPanel"/>
                <TextBlock class="hint"
                           text="TreeView = ScrollViewer + 行 Button；逻辑通过回调回到控件。"/>
            </StackPanel>
        </StackPanel>
    </Card>

    <!-- 扩展控件 + CSS 布局：padding / width / gap / opacity 全部由 demo.css 接管 -->
    <Card id="cssLayoutCard" class="section" direction="column" gap="12" padding="8" width="100%">
        <TextBlock class="label" text="EXTENDED CONTROLS · CSS LAYOUT"/>
        <StackPanel class="css-row" direction="row" gap="16" align="center">
            <SegmentedControl items="Overview|Analytics|Settings" selected-index="1"
                              onSelectionChanged="segmentAction"/>
            <RangeSlider width="230" low="0.2" high="0.7"
                         onValueChanged="rangeAction"/>
            <Chip text="Design" selected="true" onSelectionChanged="chipAction"/>
            <Chip text="Removable" closable="true" onClose="chipCloseAction"/>
            <TextBlock id="subduedText" class="hint subdued" text="CSS opacity"/>
        </StackPanel>
        <StackPanel class="css-row" direction="row" gap="20" align="start">
            <RadialGauge width="132" height="132" value="0.66" label="Load"/>
            <Sparkline class="chart"
                       values="12|18|15|24|20|31|27|38|34|46"
                       line-width="2" width="290" height="76"/>
            <StackPanel class="skeleton-stack" direction="column" gap="8">
                <Skeleton class="skeleton-line" radius="6"/>
                <Skeleton class="skeleton-line short" radius="6"/>
                <Skeleton class="skeleton-line tiny" radius="6"/>
            </StackPanel>
        </StackPanel>
    </Card>

</Card>
</ScrollViewer>
